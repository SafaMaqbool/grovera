---
import { whyChooseCards } from '../../constants/WhyChooseUs';

import Badge from '../ui/Badge.astro';
import Card from '../ui/Card.astro';
import Container from '../ui/Container.astro';

---

<section class="relative py-28 sm:py-36" id="why-choose-us">
  <Container>
    <div class="mx-auto max-w-5xl text-center">
      <div class="flex justify-center">
        <Badge>Why Grovera</Badge>
      </div>
      <h2 class="mt-6 text-balance text-3xl font-bold leading-tight tracking-tight text-text sm:text-4xl lg:text-5xl">
        Why Businesses Choose Grovera
      </h2>
    </div>

    <div class="mt-16 grid grid-cols-1 gap-5 sm:grid-cols-2">
      {whyChooseCards.map((card) => (
        <Card>
          <h3 class="text-lg font-semibold text-text">{card.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-text-muted">{card.description}</p>
        </Card>
      ))}
    </div>
  </Container>
</section>
