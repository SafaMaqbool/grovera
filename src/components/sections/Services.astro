---

import Badge from '../ui/Badge.astro';
import Card from '../ui/Card.astro';
import ServiceIcon from '../ui/ServiceIcon.astro';
import { services } from '../../constants/services';
import Container from '../ui/Container.astro';
---

<section class="relative py-28 sm:py-36" id="services">
  <Container>
    <div class="mx-auto max-w-5xl text-center">
      <div class="flex justify-center">
        <Badge>How We Help</Badge>
      </div>
      <h2 class="mt-6 text-balance text-3xl font-bold tracking-tight text-text sm:text-4xl lg:text-5xl">
        Helping Businesses Grow with Clarity and Purpose.
      </h2>
      <p class="mx-auto mt-5 max-w-4xl text-balance text-base leading-relaxed text-text-muted sm:text-lg">
        Every business has different goals, challenges, and opportunities — that is why we do not believe in one-size-fits-all marketing. Our focus is always the same: creating a strategy that supports meaningful and sustainable business growth.
      </p>
    </div>

    <div class="mt-16 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {services.map((service) => (
        <Card class="group">
          <div class="flex h-11 w-11 items-center justify-center rounded-xl border border-border bg-surface/50 text-accent-light transition-colors duration-300 group-hover:border-accent-light/40 group-hover:text-accent-light/80">
            <ServiceIcon icon={service.icon} />
          </div>
          <h3 class="mt-5 text-lg font-semibold text-text">{service.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-text-muted">{service.description}</p>
        </Card>
      ))}
    </div>
  </Container>
</section>
