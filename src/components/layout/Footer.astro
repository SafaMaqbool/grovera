---
import { footerLinks } from '../../constants/footerLinks';
import Container from '../ui/Container.astro';
import Grovera from '../../assets/images/grovera-logo.svg';
const year = new Date().getFullYear();
---

<footer class="relative border-t border-white/10 bg-bg-surface/40">
  <Container class="py-16">
    <div class="grid grid-cols-1 gap-12 sm:grid-cols-2 lg:grid-cols-4">
      <div class="lg:col-span-1">
        <a href="#" class="flex items-center gap-2 text-lg font-bold tracking-tight text-text">
          
          <Grovera class="h-6 w-auto fill-current text-accent-light" />
        </a>
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-text-muted">
          A shariah compliant growth partner helping ambitious businesses build brands, websites, and strategies that perform.
        </p>
      </div>

      <div>
        <h3 class="text-sm font-semibold text-text">Company</h3>
        <ul class="mt-4 space-y-3">
          {footerLinks.company.map((item) => (
            <li>
              <a href={item.href} class="link-underline text-sm text-text-muted transition-colors hover:text-text">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-semibold text-text">Services</h3>
        <ul class="mt-4 space-y-3">
          {footerLinks.services.map((item) => (
            <li>
              <a href={item.href} class="link-underline text-sm text-text-muted transition-colors hover:text-text">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-semibold text-text">Get in touch</h3>
        <ul class="mt-4 space-y-3 text-sm text-text-muted">
          <li>
            <a href="mailto:hello@grovera.com" class="link-underline transition-colors hover:text-text">
              hello@grovera.com
            </a>
          </li>
          <li>Karachi, Pakistan</li>
          <li class="flex gap-4 pt-1">
            {footerLinks.legal.map((item) => (
              <a href={item.href} class="link-underline transition-colors hover:text-text">
                {item.label}
              </a>
            ))}
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-14 flex flex-col items-center justify-between gap-4 border-t border-white/10 pt-8 sm:flex-row">
      <p class="text-xs text-text-muted">&copy; {year} Grovera. All rights reserved.</p>
      <div class="flex items-center gap-3">
        <a
          href="#"
          aria-label="Grovera on LinkedIn"
          class="flex h-9 w-9 items-center justify-center rounded-full border border-white/10 text-text-muted transition-colors hover:border-accent-light/40 hover:text-accent-light"
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3zm7 0h3.8v1.64h.05c.53-1 1.83-2.06 3.77-2.06 4.03 0 4.78 2.65 4.78 6.1V21h-4v-5.6c0-1.34-.02-3.06-1.87-3.06-1.87 0-2.16 1.46-2.16 2.97V21h-4z" />
          </svg>
        </a>
        <a
          href="#"
          aria-label="Grovera on X"
          class="flex h-9 w-9 items-center justify-center rounded-full border border-white/10 text-text-muted transition-colors hover:border-accent-light/40 hover:text-accent-light"
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M18.9 2H22l-7.6 8.7L23.3 22h-7.1l-5.6-7.2L4.2 22H1l8.2-9.3L1 2h7.3l5 6.6L18.9 2Zm-1.2 18h1.9L6.4 4H4.4l13.3 16Z" />
          </svg>
        </a>
      </div>
    </div>
  </Container>
</footer>
