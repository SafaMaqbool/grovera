---
import { footerLinks } from '../../constants/footerLinks';
import Container from '../ui/Container.astro';
import Logo from '../../assets/images/grovera-logo.svg';
import { Icon } from 'astro-icon/components';

interface Props {
  variant?: 'full' | 'minimal';
}

const { variant = 'full' } = Astro.props;
const year = new Date().getFullYear();
const homeHref = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<footer class="relative border-t border-white/10 bg-surface/40">
  <!-- Extra bottom padding keeps the floating WhatsApp button off the social links, which sit
       at the right from sm up; on phones they are centred and already clear of it. -->
  <Container
    class:list={['pb-12 sm:pb-24', variant === 'full' ? 'pt-12 sm:pt-20 lg:pt-24' : 'pt-8']}
  >
    {
      variant === 'full' && (
        // Below lg, Company and Get in Touch share a row and Services moves last with its
        // links in two columns, which keeps the footer short on phones.
        <div class="grid grid-cols-2 gap-x-6 gap-y-10 sm:gap-x-8 sm:gap-y-12 lg:grid-cols-12 lg:gap-12">
          <div class="col-span-2 lg:col-span-4">
            <a href={homeHref} aria-label="Grovera — home" class="inline-flex items-center gap-2">
              <img
                src={Logo.src}
                width={Logo.width}
                height={Logo.height}
                alt=""
                class="h-6 w-auto"
                loading="lazy"
                decoding="async"
              />
            </a>
            <p class="mt-4 max-w-xs text-sm leading-relaxed text-text-muted">
              A Shariah-compliant growth partner helping ambitious businesses build brands,
              websites, and strategies that perform.
            </p>
          </div>

          <div class="lg:col-span-2">
            <h3 class="text-xs font-semibold uppercase tracking-wider text-text-muted">Company</h3>
            <ul class="mt-2 lg:mt-5 lg:space-y-3">
              {footerLinks.company.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="inline-flex py-3 text-sm text-text-muted transition-colors duration-200 hover:text-text lg:py-0"
                  >
                    <span class="link-underline">{item.label}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <div class="col-span-2 max-lg:order-last lg:col-span-3">
            <h3 class="text-xs font-semibold uppercase tracking-wider text-text-muted">Services</h3>
            <ul class="mt-2 grid grid-cols-2 gap-x-6 sm:gap-x-8 lg:mt-5 lg:block lg:space-y-3">
              {footerLinks.services.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="inline-flex py-3 text-sm text-text-muted transition-colors duration-200 hover:text-text lg:py-0"
                  >
                    <span class="link-underline">{item.label}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <div class="lg:col-span-3">
            <h3 class="text-xs font-semibold uppercase tracking-wider text-text-muted">
              Get in Touch
            </h3>
            <ul class="mt-2 text-sm text-text-muted lg:mt-5 lg:space-y-3">
              <li>
                <a
                  href="mailto:hello@grovera.com"
                  class="inline-flex items-center gap-2 py-3 transition-colors duration-200 hover:text-text lg:py-0"
                >
                  <Icon name="heroicons:envelope" class="h-4 w-4 shrink-0" />
                  <span class="link-underline">hello@grovera.com</span>
                </a>
              </li>
              <li class="flex items-center gap-2 py-3 lg:py-0">
                <Icon name="heroicons:map-pin" class="h-4 w-4 shrink-0" />
                Karachi, Pakistan
              </li>
            </ul>
          </div>
        </div>
      )
    }

    <div
      class:list={[
        'flex flex-col items-center justify-between gap-6 sm:flex-row',
        variant === 'full' && 'mt-10 border-t border-white/10 pt-8 sm:mt-14',
      ]}
    >
      <div class="flex flex-col items-center gap-3 text-xs text-text-muted sm:flex-row sm:gap-5">
        <p>&copy; {year} Grovera. All rights reserved.</p>
        <div class="flex items-center gap-4">
          {
            footerLinks.legal.map((item) =>
              item.href ? (
                <a
                  href={item.href}
                  class="inline-flex py-3 transition-colors duration-200 hover:text-text sm:py-0"
                >
                  <span class="link-underline">{item.label}</span>
                </a>
              ) : (
                <span
                  aria-disabled="true"
                  title="Coming soon"
                  class="cursor-not-allowed select-none text-text-muted/50"
                >
                  {item.label}
                </span>
              ),
            )
          }
        </div>
      </div>
      <div class="flex items-center gap-3">
        {
          footerLinks.icons.map((item) => (
            <a
              href={item.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={item.label}
              class="text-text-muted transition-colors duration-200 hover:text-text"
            >
              <Icon name={item.icon} class="h-5 w-5" />
            </a>
          ))
        }
      </div>
    </div>
  </Container>
</footer>
