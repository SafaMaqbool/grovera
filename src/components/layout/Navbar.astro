---
import Container from "../ui/Container.astro";
import logo from "../../assets/images/logo-full.png";
---

<header
  class="fixed inset-x-0 top-0 z-50 border-b border-white/5 bg-background/70 backdrop-blur-xl"
>
  <Container>
    <nav class="flex h-18 items-center justify-between">
      <a href="/" aria-label="Grovera Home">
        <img
          src={logo.src}
          alt="Grovera"
          class="h-10 w-auto"
        />
      </a>

      <div class="hidden items-center gap-10 lg:flex">
        <a
          href="#services"
          class="text-sm font-medium text-white/70 transition duration-300 hover:text-white"
        >
          Services
        </a>

        <a
          href="#why-us"
          class="text-sm font-medium text-white/70 transition duration-300 hover:text-white"
        >
          Why Grovera
        </a>

        <a
          href="#faq"
          class="text-sm font-medium text-white/70 transition duration-300 hover:text-white"
        >
          FAQ
        </a>

        <a
          href="#contact"
          class="rounded-2xl border border-white/10 bg-accent px-6 py-3 text-sm font-medium text-white shadow-lg shadow-black/20 transition-all duration-300 hover:-translate-y-0.5 hover:bg-accent-light"
        >
          Get in Touch
        </a>
      </div>

      <button
        class="text-white lg:hidden"
        aria-label="Open Menu"
      >
        ☰
      </button>
    </nav>
  </Container>
</header>