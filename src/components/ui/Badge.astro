---
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<div
  class:list={[
    "inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-5 py-2 backdrop-blur-md",
    className,
  ]}
>
  <span class="h-2 w-2 rounded-full bg-accent-light animate-pulse"></span>

  <span class="text-sm font-medium text-text-muted">
    <slot />
  </span>
</div>