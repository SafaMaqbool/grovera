---
interface Props {
  title?: string;
  class?: string;
}

const { title, class: className = '', ...rest } = Astro.props;
---

<div
  class:list={[
    'rounded-3xl border border-white/10 bg-surface/80 p-8 backdrop-blur-md transition-all duration-300 hover:-translate-y-1 hover:border-accent/40 hover:shadow-2xl',
    className,
  ]}
  {...rest}
>
  {title && <h3 class="mb-6 text-2xl font-semibold text-text">{title}</h3>}

  <slot />
</div>
