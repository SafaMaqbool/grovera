---
import { Icon } from 'astro-icon/components';
import { SITE } from '../../constants/site';

const message = 'Hi Grovera, I would like to know more about your services';
const href = `https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent(message)}`;
---

<a
  id="whatsapp-button"
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Chat with us on WhatsApp"
  class="invisible fixed bottom-4 right-4 z-40 flex translate-y-4 opacity-0 h-12 w-12 items-center justify-center rounded-full bg-[#25D366] text-white shadow-lg shadow-black/20 transition-all duration-300 ease-out hover:scale-110 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-light focus-visible:ring-offset-2 focus-visible:ring-offset-background sm:bottom-5 sm:right-5 sm:h-14 sm:w-14"
>
  <Icon name="simple-icons:whatsapp" class="h-7 w-7 sm:h-8 sm:w-8" aria-hidden="true" />
</a>

<script>
  // Hidden while the hero is on screen so it does not sit on the hero's floating cards.
  const button = document.getElementById('whatsapp-button');
  const hero = document.getElementById('hero');
  const hiddenClasses = ['invisible', 'opacity-0', 'translate-y-4'];

  if (button) {
    const update = () => {
      const heroPassed = !hero || hero.getBoundingClientRect().bottom < window.innerHeight * 0.5;
      hiddenClasses.forEach((c) => button.classList.toggle(c, !heroPassed));
    };

    update();
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update, { passive: true });
  }
</script>
