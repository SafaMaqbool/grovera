---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'section'> {
  padding?: 'default' | 'tight';
  background?: boolean;
}

const { padding = 'default', background = false, class: className, ...rest } = Astro.props;

const paddingClass = padding === 'tight' ? 'py-10 sm:py-16' : 'py-12 sm:py-20';
---

<section class:list={[paddingClass, { 'bg-background': background }, className]} {...rest}>
  <slot />
</section>
