---
import Badge from './Badge.astro';

interface Props {
  badge?: string;
  title: string;
  description?: string;
  class?: string;
  descriptionClass?: string;
}

const {
  badge,
  title,
  description,
  class: className = 'max-w-3xl',
  descriptionClass = 'max-w-2xl',
} = Astro.props;
---

<div class:list={['mx-auto text-center', className]}>
  {
    badge && (
      <div class="mb-6 flex justify-center">
        <Badge>{badge}</Badge>
      </div>
    )
  }
  <h2 class="text-balance text-3xl font-bold tracking-tight text-text sm:text-4xl lg:text-5xl">
    {title}
  </h2>
  {
    description && (
      <p
        class:list={[
          'mx-auto mt-5 text-left text-base leading-relaxed text-text-muted sm:text-lg md:text-balance md:text-center',
          descriptionClass,
        ]}
      >
        {description}
      </p>
    )
  }
</div>
