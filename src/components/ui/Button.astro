---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary';
  class?: string;
  type?: 'button' | 'submit';
}

const { href, variant = 'primary', class: className = '', type = 'button', ...rest } = Astro.props;

const base =
  'group relative inline-flex items-center justify-center gap-2 rounded-full px-6 py-3 text-sm font-semibold transition-all duration-300 ease-out focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-light focus-visible:ring-offset-2 focus-visible:ring-offset-background';

const variants = {
  primary:
    'bg-accent text-white shadow-glow hover:bg-accent-light hover:text-background hover:-translate-y-0.5 active:translate-y-0',
  secondary:
    'text-text border border-white/15 hover:border-accent-light/60 hover:text-accent-light',
};

const Tag = href ? 'a' : 'button';
---

<Tag
  href={href}
  type={!href ? type : undefined}
  class={`${base} ${variants[variant]} ${className}`}
  {...rest}
>
  <slot />
  {variant === 'primary' && (
    <svg
      class="h-4 w-4 transition-transform duration-300 ease-out group-hover:translate-x-0.5"
      viewBox="0 0 16 16"
      fill="none"
      aria-hidden="true"
    >
      <path d="M3.5 8h9M8.5 3.5 13 8l-4.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  )}
</Tag>
