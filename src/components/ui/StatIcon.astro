---
interface Props {
  icon: 'impressions' | 'leads' | 'enrolments';
  class?: string;
}
const { icon, class: className = 'h-5 w-5' } = Astro.props;
---

{
  icon === 'impressions' && (
    <svg
      class={className}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.25"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M2 12s3.5-6.5 10-6.5S22 12 22 12s-3.5 6.5-10 6.5S2 12 2 12Z" />
      <circle cx="12" cy="12" r="3" />
    </svg>
  )
}
{
  icon === 'leads' && (
    <svg
      class={className}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.25"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <circle cx="9" cy="8" r="3.25" />
      <path d="M3.5 19c.7-3 2.8-4.75 5.5-4.75S13.8 16 14.5 19" />
      <path d="M16 8.5a2.75 2.75 0 1 1 3 4.6M17.5 14c1.9.55 3 1.9 3.5 3.8" />
    </svg>
  )
}
{
  icon === 'enrolments' && (
    <svg
      class={className}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.25"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M2 8 12 3l10 5-10 5L2 8Z" />
      <path d="M6 10.5V16c0 1.5 2.7 3 6 3s6-1.5 6-3v-5.5M22 8v6" />
    </svg>
  )
}
