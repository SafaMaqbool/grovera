---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Grovera | Shariah-Compliant Growth Partner",
  description =
    "Grovera helps educational institutes grow through strategic marketing rooted in Islamic values.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <title>{title}</title>

    <meta
      name="description"
      content={description}
    />

    <link
      rel="icon"
      type="image/svg+xml"
      href="/favicon.svg"
    />

    <slot name="head" />
  </head>

  <body>
    <slot />
  </body>
</html>