---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import GridBackground from '../components/ui/GridBackground.astro';
import {
  privacyContactEmail,
  privacyLastUpdated,
  privacySections,
} from '../constants/privacyPolicy';
---

<BaseLayout
  title="Privacy Policy | Grovera"
  description="How Grovera collects, uses and protects the personal information you share when you visit our website or contact us."
  path="/privacy/"
  variant="minimal"
>
  <main id="main">
    <section class="relative overflow-hidden pt-32 pb-10 sm:pt-48 sm:pb-16">
      <GridBackground />
      <div
        class="pointer-events-none absolute left-1/2 top-0 h-150 w-225 -translate-x-1/2 -translate-y-1/3 radial-glow blur-3xl"
        aria-hidden="true"
      >
      </div>

      <Container class="relative">
        <div class="mx-auto max-w-3xl">
          <h1
            class="fade-up text-balance text-4xl font-bold leading-[1.1] tracking-tight text-text sm:text-6xl"
          >
            Privacy Policy
          </h1>
          <p class="fade-up delay-1 mt-6 text-sm text-text-muted">
            Last updated: <time datetime={privacyLastUpdated.iso}>{privacyLastUpdated.label}</time>
          </p>
        </div>
      </Container>
    </section>

    <section class="pb-16 sm:pb-24">
      <Container>
        <ol class="mx-auto max-w-3xl space-y-10 sm:space-y-12">
          {
            privacySections.map((section, i) => (
              <li>
                <h2 class="text-xl font-semibold tracking-tight text-text sm:text-2xl">
                  <span class="text-accent-light">{i + 1}.</span> {section.title}
                </h2>
                <div class="mt-4 space-y-4 text-base leading-relaxed text-text-muted">
                  {section.blocks.map((block) =>
                    Array.isArray(block) ? (
                      <ul class="list-disc space-y-2 pl-5 marker:text-accent-light">
                        {block.map((item) => (
                          <li>{item}</li>
                        ))}
                      </ul>
                    ) : (
                      <p>{block}</p>
                    ),
                  )}
                  {i === privacySections.length - 1 && (
                    <p>
                      Email:{' '}
                      <a
                        href={`mailto:${privacyContactEmail}`}
                        class="break-all text-accent-light underline underline-offset-2 transition-colors hover:text-text"
                      >
                        {privacyContactEmail}
                      </a>
                    </p>
                  )}
                </div>
              </li>
            ))
          }
        </ol>
      </Container>
    </section>
  </main>
</BaseLayout>
